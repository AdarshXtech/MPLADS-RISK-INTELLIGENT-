# Optional. Context7 works without a key, but a key may provide higher limits.
CONTEXT7_API_KEY=

# Required before enabling the Stitch MCP server.
STITCH_API_KEY=

# Future only. Add after the team lead creates the GitHub repository.
# GITHUB_PAT_TOKEN=

# Optional for explicit PostgreSQL staging. Set in the launching environment.
# No credentials are needed for file-only ingestion.
DATABASE_URL=

# Dedicated disposable database for opt-in integration tests only.
TEST_DATABASE_URL=

# Local PostgreSQL setup/administration only. Keep values secret.
MPLADS_DB_PASSWORD=
MPLADS_TEST_DB_PASSWORD=
SIH_POSTGRES_ADMIN_PASSWORD=

# Optional local runtime path used by team shell tooling. Not a secret.
SIH_POSTGRES_BIN=

# Server-side Next.js connection to the FastAPI service. Not a secret.
MPLADS_API_BASE_URL=http://127.0.0.1:8000

# Required for the local Investigation Queue. Use strong, unique values.
MPLADS_REVIEW_USERNAME=
MPLADS_REVIEW_PASSWORD=
MPLADS_SESSION_SECRET=
MPLADS_REVIEW_API_KEY=

# Set false only for local HTTP testing. Keep secure cookies enabled in production.
MPLADS_SECURE_COOKIES=true
